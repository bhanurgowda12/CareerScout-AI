# Firebase web-app configuration is public client configuration, not a private secret.
# Replace each placeholder before using Firebase locally.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
# Required for production App Check; replace with the registered reCAPTCHA Enterprise site key.
VITE_FIREBASE_APP_CHECK_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
# Development only. Register the generated debug token in Firebase App Check.
VITE_FIREBASE_APP_CHECK_DEBUG=false
# Emulator connections are disabled unless explicitly enabled in development.
VITE_FIREBASE_USE_EMULATORS=false
# Local development default. Set an explicit HTTPS URL for production builds.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Backend deadline defaults to 15 seconds; leave 2 seconds for the response to reach the browser.
VITE_JOB_DISCOVERY_TIMEOUT_MS=17000
# Client-side limit for each learning-resource API request.
VITE_LEARNING_RESOURCES_TIMEOUT_MS=15000
