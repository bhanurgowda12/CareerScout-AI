# Copy to frontend/.env.emulator for local Emulator Suite use.
# These values are synthetic and must never be replaced with production credentials.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-careerscout-ai
VITE_FIREBASE_STORAGE_BUCKET=demo-careerscout-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:emulatoronly
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_FIREBASE_APP_CHECK_DEBUG=false
VITE_FIREBASE_USE_EMULATORS=true
VITE_API_BASE_URL=http://127.0.0.1:8000
